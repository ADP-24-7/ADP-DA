APP_ENV=local
SERVICE_NAME=adp-da
LOG_LEVEL=INFO

ADP_BE_PORT=8080
ADP_FE_PORT=5173
ADP_DA_PORT=8010
ADP_DOCS_PORT=3000

POSTGRES_DB=adp
POSTGRES_USER=adp
POSTGRES_PASSWORD=adp
POSTGRES_PORT=5432

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/adp
SPRING_DATASOURCE_USERNAME=adp
SPRING_DATASOURCE_PASSWORD=adp

ADP_LOCAL_USER_AUTH_ENABLED=true
ADP_LOCAL_FIXTURES_ENABLED=true
ADP_MOCK_RUNTIME_ENABLED=true
ADP_AI_CONNECTOR_ENABLED=true
ADP_AI_CONNECTOR_BASE_URL=http://mock-ai:8090
ADP_AI_CONNECTOR_CONNECT_TIMEOUT=2s
ADP_AI_CONNECTOR_READ_TIMEOUT=5s
ADP_DATA_ACCESS_PREVIEW_ENABLED=true
ADP_CONTEXT_PREVIEW_ENABLED=true

# BE NVIDIA connector. Keep NVIDIA_API_KEY empty in this tracked example and
# set the real value only in the ignored local .env file or process environment.
NVIDIA_API_KEY=
ADP_NVIDIA_BASE_URL=https://integrate.api.nvidia.com

VITE_APP_ENV=local
VITE_API_MODE=real
VITE_API_BASE_URL=http://adp-be:8080

GATEWAY_CORE_URL=http://adp-be:8080
ARTIFACT_OUTPUT_DIR=artifacts

# DA Python NVIDIA NIM client settings. NVIDIA_API_KEY above is shared by name;
# NVIDIA_BASE_URL and NVIDIA_MODEL are used only by the DA client.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
