APP_ENV=local
SERVICE_NAME=adp-da
LOG_LEVEL=INFO

# The integration stack, PostgreSQL, BE Connector, and BE NVIDIA credential are
# owned by ../ADP-BE/docker-compose.yml and ../ADP-BE/.env.
GATEWAY_CORE_URL=http://adp-be:8080
ADP_BE_BASE_URL=http://adp-be:8080
ADP_RUNTIME_API_KEY=local-dev-api-key
ADP_BE_LOCAL_ADMIN_USER_ID=da-evaluation-reader
ADP_BE_LOCAL_ADMIN_ROLES=PRIVILEGED_OPERATOR
# Keep NO by default. Set YES only for an intentional three-model real Provider run.
ADP_AI_E2E_CONFIRM_REAL_PROVIDER=NO
# Remote Bearer is unsupported by the current BE. Populate/enable both only after
# an operational bearer authentication adapter is deployed and verified.
ADP_BE_TOKEN=
ADP_BE_REMOTE_BEARER_AUTH_ENABLED=NO
ARTIFACT_OUTPUT_DIR=artifacts

# Optional DA-only Python NVIDIA NIM client settings. These are not passed to BE.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# NCP Object Storage non-secret connection metadata. Credentials belong only in
# the ignored .env.ncp.local file or the process environment.
NCLOUD_REGION=KR
ADP_NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
ADP_NCP_ARTIFACT_BUCKET=adp-qa-data-artifacts
