# Copy to .env.ncp.local (ignored by Git) and chmod 600.
# Never commit or print real credential values.
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
NCLOUD_REGION=KR
ADP_NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
ADP_NCP_ARTIFACT_BUCKET=adp-qa-data-artifacts
ADP_NCP_ALLOWED_ARTIFACT_BUCKETS=adp-qa-data-artifacts
# External write/delete drill. Change to YES only for an intentional E2E run.
ADP_NCP_STORAGE_E2E_CONFIRM=NO
