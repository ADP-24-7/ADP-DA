{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp.local/contracts/ai-evaluation-bundle.schema.json",
  "title": "ADP AI Evaluation Bundle",
  "type": "object",
  "required": [
    "manifest",
    "execution_config",
    "case_results",
    "runtime_metrics",
    "failure_summary",
    "trace_index"
  ],
  "properties": {
    "contract_evidence": {
      "$ref": "#/$defs/contract_evidence"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "execution_config": {
      "$ref": "#/$defs/execution_config"
    },
    "case_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_result"
      }
    },
    "runtime_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtime_metric"
      }
    },
    "failure_summary": {
      "$ref": "#/$defs/failure_summary"
    },
    "trace_index": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace_entry"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest": {
            "properties": {
              "schema_version": {
                "const": "adp-ai-evaluation-bundle/v2"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "contract_evidence"
        ],
        "properties": {
          "manifest": {
            "properties": {
              "bundle_version": {
                "const": "2.0.0"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "contract_evidence"
          ]
        },
        "properties": {
          "manifest": {
            "properties": {
              "bundle_version": {
                "const": "1.0.0"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contract_snapshot": {
      "type": "object",
      "required": [
        "fixed_conditions",
        "fixed_conditions_digest",
        "model_profiles"
      ],
      "properties": {
        "fixed_conditions": {
          "type": "object",
          "required": [
            "evaluation_run_id",
            "evaluation_contract_version",
            "workload",
            "purpose_code",
            "dataset_version",
            "prompt_version",
            "policy_version",
            "case_set_version",
            "transform_scope",
            "dataset_digest",
            "prompt_snapshot_digest",
            "policy_snapshot_digest",
            "transform_version",
            "rag_version",
            "destination_contract_digest",
            "retrieved_context_digest",
            "rag_mode",
            "seed_control",
            "reasoning_control",
            "stream",
            "temperature",
            "max_tokens",
            "retrieval_config",
            "cases",
            "prompt_snapshot",
            "transform_snapshot"
          ],
          "properties": {
            "evaluation_run_id": {
              "type": "string",
              "minLength": 1
            },
            "evaluation_contract_version": {
              "type": "string",
              "minLength": 1
            },
            "workload": {
              "type": "string",
              "minLength": 1
            },
            "purpose_code": {
              "type": "string",
              "minLength": 1
            },
            "dataset_version": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "case_set_version": {
              "type": "string",
              "minLength": 1
            },
            "transform_scope": {
              "type": "string",
              "minLength": 1
            },
            "dataset_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "prompt_snapshot_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policy_snapshot_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "transform_version": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "rag_version": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "destination_contract_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "retrieved_context_digest": {
              "$ref": "#/$defs/required_digest"
            },
            "rag_mode": {
              "const": "PREDEFINED_RETRIEVAL"
            },
            "seed_control": {
              "const": "NOT_CONFIGURABLE"
            },
            "reasoning_control": {
              "const": "NOT_CONFIGURABLE"
            },
            "stream": {
              "const": false
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "retrieval_config": {
              "type": "object",
              "required": [
                "adapter_version",
                "profile_id",
                "scopes",
                "fields",
                "as_of_date"
              ]
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "caseId",
                  "datasetRowRef",
                  "inputSchemaVersion",
                  "expectedInputDigest"
                ]
              }
            },
            "prompt_snapshot": {
              "type": "object",
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "transform_snapshot": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "instruction_digest"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "instruction_digest": {
                    "$ref": "#/$defs/required_digest"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "fixed_conditions_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_profiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/model_config"
              },
              {
                "required": [
                  "destination_profile_id",
                  "provider"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "contract_evidence": {
      "type": "object",
      "required": [
        "snapshot",
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/contract_snapshot"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "execution_id",
              "evaluation_run_id",
              "eval_case_id",
              "decision_id",
              "transform_execution_id",
              "outbound_payload_id",
              "fixed_conditions_digest",
              "model_profile_digest",
              "provider_request_digest",
              "provider_input_digest",
              "outbound_guard_status"
            ],
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1
              },
              "evaluation_run_id": {
                "type": "string",
                "minLength": 1
              },
              "eval_case_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_id": {
                "type": "string",
                "minLength": 1
              },
              "transform_execution_id": {
                "type": "string",
                "minLength": 1
              },
              "outbound_payload_id": {
                "type": "string",
                "minLength": 1
              },
              "fixed_conditions_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "model_profile_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "provider_request_digest": {
                "$ref": "#/$defs/required_digest"
              },
              "provider_input_digest": {
                "$ref": "#/$defs/provenance_digest"
              },
              "outbound_guard_status": {
                "const": "PASSED"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "required_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "bundle_id",
        "bundle_version",
        "content_digest",
        "evaluation_run_id",
        "evaluation_run_version",
        "execution_count",
        "case_count",
        "model_count",
        "generated_at",
        "execution_from",
        "execution_cutoff_at"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "adp-ai-evaluation-bundle/v1",
            "adp-ai-evaluation-bundle/v2"
          ]
        },
        "bundle_id": {
          "type": "string"
        },
        "bundle_version": {
          "enum": [
            "1.0.0",
            "2.0.0"
          ]
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evaluation_run_id": {
          "type": "string"
        },
        "evaluation_run_version": {
          "type": "string"
        },
        "execution_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "model_count": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_from": {
          "type": "string",
          "format": "date-time"
        },
        "execution_cutoff_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "execution_config": {
      "type": "object",
      "required": [
        "evaluation_run_id",
        "evaluation_run_version",
        "evaluation_contract_digest",
        "dataset_id",
        "dataset_version",
        "dataset_digest",
        "policy_snapshot_digest",
        "models"
      ],
      "properties": {
        "evaluation_run_id": {
          "type": "string"
        },
        "evaluation_run_version": {
          "type": "string"
        },
        "evaluation_contract_digest": {
          "$ref": "#/$defs/provenance_digest"
        },
        "dataset_id": {
          "type": "string"
        },
        "dataset_version": {
          "type": "string"
        },
        "dataset_digest": {
          "$ref": "#/$defs/provenance_digest"
        },
        "policy_snapshot_digest": {
          "$ref": "#/$defs/provenance_digest"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/model_config"
          }
        }
      },
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_version",
        "profile_digest",
        "provider_model_id",
        "provider_model_version",
        "connection_profile_id",
        "max_tokens",
        "temperature",
        "sampling_profile_version",
        "destination_profile_digest"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "profile_digest": {
          "$ref": "#/$defs/provenance_digest"
        },
        "provider_model_id": {
          "type": "string"
        },
        "provider_model_version": {
          "type": "string"
        },
        "connection_profile_id": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "sampling_profile_version": {
          "type": "string"
        },
        "destination_profile_digest": {
          "$ref": "#/$defs/provenance_digest"
        },
        "destination_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "const": "NVIDIA"
        }
      },
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "required": [
        "execution_id",
        "eval_case_id",
        "model_profile_id",
        "runtime_status",
        "final_action",
        "response_guard_status",
        "controlled_delivery_status",
        "provider_status",
        "error_category",
        "evidence_status",
        "expected_input_digest",
        "actual_input_digest"
      ],
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "eval_case_id": {
          "type": "string"
        },
        "model_profile_id": {
          "type": "string"
        },
        "runtime_status": {
          "enum": [
            "RECEIVED",
            "AUTHORIZED",
            "RETRIEVED",
            "DECIDED",
            "TRANSFORMED",
            "EGRESSING",
            "EXTERNALLY_RECONCILED",
            "COMPLETED",
            "REVIEW_REQUIRED",
            "BLOCKED",
            "FAILED"
          ]
        },
        "final_action": {
          "enum": [
            "ALLOW",
            "TRANSFORM",
            "REVIEW",
            "BLOCK"
          ]
        },
        "response_guard_status": {
          "enum": [
            "PASSED",
            "REJECTED",
            "NOT_EVALUATED"
          ]
        },
        "controlled_delivery_status": {
          "enum": [
            "DELIVERED",
            "WITHHELD"
          ]
        },
        "provider_status": {
          "enum": [
            "NOT_SENT",
            "SENT_UNKNOWN",
            "ACKNOWLEDGED",
            "COMPLETED",
            "FAILED"
          ]
        },
        "error_category": {
          "enum": [
            "NONE",
            "CONNECTION_CONFIGURATION",
            "TRANSPORT",
            "PROVIDER_CLIENT_ERROR",
            "PROVIDER_SERVER_ERROR",
            "RESPONSE_PARSE_ERROR"
          ]
        },
        "evidence_status": {
          "const": "COMPLETE"
        },
        "expected_input_digest": {
          "$ref": "#/$defs/required_digest"
        },
        "actual_input_digest": {
          "$ref": "#/$defs/required_digest"
        }
      },
      "additionalProperties": false
    },
    "runtime_metric": {
      "type": "object",
      "required": [
        "execution_id",
        "eval_case_id",
        "model_profile_id",
        "measurement_type",
        "full_response_latency_millis",
        "attempt_elapsed_millis",
        "initial_runtime_latency_millis",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "token_usage_status",
        "provider_http_status",
        "provider_status",
        "error_category"
      ],
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "eval_case_id": {
          "type": "string"
        },
        "model_profile_id": {
          "type": "string"
        },
        "measurement_type": {
          "enum": [
            "HTTP_FULL_RESPONSE",
            "HTTP_ATTEMPT_NO_RESPONSE",
            "NOT_ATTEMPTED",
            "MOCK"
          ]
        },
        "full_response_latency_millis": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attempt_elapsed_millis": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "initial_runtime_latency_millis": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_usage_status": {
          "enum": [
            "COMPLETE",
            "NOT_PROVIDED",
            "INCOMPLETE",
            "INVALID"
          ]
        },
        "provider_http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "provider_status": {
          "enum": [
            "NOT_SENT",
            "SENT_UNKNOWN",
            "ACKNOWLEDGED",
            "COMPLETED",
            "FAILED"
          ]
        },
        "error_category": {
          "enum": [
            "NONE",
            "CONNECTION_CONFIGURATION",
            "TRANSPORT",
            "PROVIDER_CLIENT_ERROR",
            "PROVIDER_SERVER_ERROR",
            "RESPONSE_PARSE_ERROR"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurement_type": {
                "const": "HTTP_FULL_RESPONSE"
              }
            }
          },
          "then": {
            "properties": {
              "full_response_latency_millis": {
                "type": "integer",
                "minimum": 0
              },
              "attempt_elapsed_millis": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_type": {
                "const": "HTTP_ATTEMPT_NO_RESPONSE"
              }
            }
          },
          "then": {
            "properties": {
              "full_response_latency_millis": {
                "type": "null"
              },
              "attempt_elapsed_millis": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_type": {
                "const": "NOT_ATTEMPTED"
              }
            }
          },
          "then": {
            "properties": {
              "full_response_latency_millis": {
                "type": "null"
              },
              "attempt_elapsed_millis": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_type": {
                "const": "MOCK"
              }
            }
          },
          "then": {
            "properties": {
              "full_response_latency_millis": {
                "const": 0
              },
              "attempt_elapsed_millis": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token_usage_status": {
                "const": "COMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "input_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              },
              "total_tokens": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "failure_summary": {
      "type": "object",
      "required": [
        "evaluated_execution_count",
        "failed",
        "sent_unknown",
        "not_attempted",
        "by_error_category"
      ],
      "properties": {
        "evaluated_execution_count": {
          "type": "integer",
          "minimum": 1
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "sent_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "by_error_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "trace_entry": {
      "type": "object",
      "required": [
        "execution_id",
        "decision_id",
        "connector_execution_id",
        "provider_request_digest",
        "provider_response_digest",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "connector_execution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_request_digest": {
          "$ref": "#/$defs/nullable_digest"
        },
        "provider_response_digest": {
          "$ref": "#/$defs/nullable_digest"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "transform_execution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outbound_payload_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outbound_guard_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
