{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ADP-24-7/ADP-DA/contracts/ai_runtime_validation_vnext.schema.json",
  "title": "AI Runtime Validation vNext",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_version",
    "status",
    "validation_errors",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "vNext"
    },
    "artifact_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
