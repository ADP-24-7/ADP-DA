{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp.local/contracts/reference-evidence-bundle-v1.schema.json",
  "title": "ADP Reference Evidence Bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "snapshot_at",
    "analysis_version",
    "evidence_count",
    "evidence",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "adp-reference-evidence-bundle/v1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{4,119}$"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "snapshot_at": {"type": "string", "format": "date-time"},
    "analysis_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "evidence_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDate": {"type": ["string", "null"], "format": "date"},
    "boundedRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_version",
        "evidence_type",
        "authority",
        "title",
        "source_ref",
        "source_url",
        "source_date",
        "effective_from",
        "effective_to",
        "claim_scope",
        "claim_summary",
        "source_locator",
        "analysis_version",
        "status",
        "workload_refs",
        "policy_artifact_refs",
        "content_digest"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^REF-[A-Z0-9][A-Z0-9-]{4,79}$"},
        "evidence_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evidence_type": {
          "enum": [
            "REGULATION",
            "REGULATORY_SANDBOX",
            "POLICY_GUIDE",
            "BANK_TREND",
            "DIGITAL_ASSET_INFRA"
          ]
        },
        "authority": {"type": "string", "minLength": 1, "maxLength": 160},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_url": {"type": ["string", "null"], "format": "uri", "maxLength": 1000},
        "source_date": {"$ref": "#/$defs/nullableDate"},
        "effective_from": {"$ref": "#/$defs/nullableDate"},
        "effective_to": {"$ref": "#/$defs/nullableDate"},
        "claim_scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "claim_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 500},
        "analysis_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {"enum": ["VERIFIED", "REFERENCE_ONLY", "REVIEW_REQUIRED", "SUPERSEDED"]},
        "workload_refs": {"$ref": "#/$defs/boundedRefs"},
        "policy_artifact_refs": {"$ref": "#/$defs/boundedRefs"},
        "content_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
