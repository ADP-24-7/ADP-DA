{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Asset Candidate Policy",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_version",
    "status",
    "runtime_scope",
    "policy_rules",
    "digest"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "validated",
        "hold",
        "rejected"
      ]
    },
    "runtime_scope": {
      "type": "string"
    },
    "policy_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "explicit_non_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
