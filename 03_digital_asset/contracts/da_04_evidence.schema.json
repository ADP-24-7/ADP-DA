{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DA-04 analytical evidence, not provider wire schema",
  "type": "object",
  "required": ["artifact_id", "artifact_version", "generated_at", "source_notebook", "source_notebook_code_sha256", "source_data", "source_data_sha256", "evidence_refs", "analysis_scope", "provider_wire_schema", "live_be_evaluation"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^DA_04_OUTBOUND_DESTINATION:(analysis_summary|validation_metrics|destination_payload_profile|runtime_requirements|contract_gaps)$"},
    "artifact_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_notebook": {"type": "string"},
    "source_notebook_code_sha256": {"$ref": "#/$defs/digest"},
    "source_data": {"type": "string"},
    "source_data_sha256": {"$ref": "#/$defs/digest"},
    "analysis_scope": {"const": "DETERMINISTIC_CONTRACT_AND_OBSERVED_SAMPLE"},
    "provider_wire_schema": {"const": false},
    "live_be_evaluation": {"const": false},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["path", "sha256", "sha256_scope"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}, "sha256_scope": {"enum": ["RAW_BYTES", "UTF8_BYTES_CRLF_TO_LF"]}}
    }},
    "profiles": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["destination", "runtime_phase", "allowed_fields", "required_fields", "internal_only_fields", "required_exact_fields", "on_missing_action"],
      "properties": {
        "destination": {"enum": ["TRAVEL_RULE_PROVIDER", "EXTERNAL_VASP", "BLOCKCHAIN_EXECUTION_SYSTEM", "INTERNAL_RECONCILIATION_ONLY", "INTERNAL_AUDIT_ONLY", "NOT_EXTERNALIZED"]},
        "runtime_phase": {"enum": ["PRE_EXECUTION", "POST_EXECUTION"]},
        "allowed_fields": {"$ref": "#/$defs/fields"}, "required_fields": {"$ref": "#/$defs/fields"},
        "internal_only_fields": {"$ref": "#/$defs/fields"}, "required_exact_fields": {"$ref": "#/$defs/fields"},
        "on_missing_action": {"type": "object"}
      }
    }}
  },
  "allOf": [
    {"if": {"properties": {"artifact_id": {"const": "DA_04_OUTBOUND_DESTINATION:analysis_summary"}}}, "then": {"required": ["metrics", "destination_summary", "field_availability", "legacy_to_vnext"]}},
    {"if": {"properties": {"artifact_id": {"const": "DA_04_OUTBOUND_DESTINATION:validation_metrics"}}}, "then": {"required": ["exposure", "invariants", "negative_controls", "contract_violations"]}},
    {"if": {"properties": {"artifact_id": {"const": "DA_04_OUTBOUND_DESTINATION:destination_payload_profile"}}}, "then": {"required": ["profiles", "lineage", "contract_level"]}},
    {"if": {"properties": {"artifact_id": {"const": "DA_04_OUTBOUND_DESTINATION:runtime_requirements"}}}, "then": {"required": ["pipeline", "decision_semantics", "fpg_boundary"]}},
    {"if": {"properties": {"artifact_id": {"const": "DA_04_OUTBOUND_DESTINATION:contract_gaps"}}}, "then": {"required": ["gaps"]}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
