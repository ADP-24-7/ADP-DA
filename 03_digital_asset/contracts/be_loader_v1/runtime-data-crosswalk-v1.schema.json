{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_id", "artifact_version", "status", "payload"],
  "properties": {
    "schema_version": { "const": "adp-digital-asset-handoff-document/v1" },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "artifact_version": { "const": "1.0.0" },
    "status": { "const": "VALIDATED" },
    "payload": {
      "type": "object",
      "required": ["runtime_data_classes"],
      "properties": {
        "runtime_data_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CUSTOMER_IDENTIFIER",
              "ACCOUNT_IDENTIFIER",
              "TRANSACTION_IDENTIFIER",
              "FINANCIAL_AMOUNT",
              "FINANCIAL_METADATA",
              "BUSINESS_METADATA",
              "UNKNOWN"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
